@main

// Indirect index walk: 65536-slot ring, 20e6 steps.
// Probes gather-like LoadIndex with a data-dependent subscript.
fn fill() []int {
    n := 65536
    $nxt := []int{}
    $i := 0
    while i < n {
        nxt.push(((i * 7) + 1) & (n - 1))
        i += 1
    }
    << nxt
}

fn main() int {
    nxt := fill()
    $k := 0
    $s := 0
    while s < 20000000 {
        k = nxt[k]
        s += 1
    }
    println(k)
    << 0
}
