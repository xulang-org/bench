@main

fn main() int {
    mod_v := 1000000007
    n_cust := 8192
    ht_cap := 16384
    ht_mask := 16383
    n_ord := 200000
    $rng := 42424242

    $cust_id := []int{}
    $cust_reg := []int{}
    $cust_tier := []int{}
    $i := 0
    while i < n_cust {
        cust_id.push(0)
        cust_reg.push(0)
        cust_tier.push(0)
        i += 1
    }

    $ht_key := []int{}
    $ht_val := []int{}
    i = 0
    while i < ht_cap {
        ht_key.push(-1)
        ht_val.push(-1)
        i += 1
    }

    i = 0
    while i < n_cust {
        rng = (rng * 1103515245 + 12345) & 2147483647
        cid := 100000 + i * 7 + (rng % 5)
        cust_id[i] = cid
        rng = (rng * 1103515245 + 12345) & 2147483647
        cust_reg[i] = rng % 16
        rng = (rng * 1103515245 + 12345) & 2147483647
        cust_tier[i] = rng % 4
        $slot := ((cid * 2654435761) >> 16) & ht_mask
        while ht_key[slot] != -1 {
            slot = (slot + 1) & ht_mask
        }
        ht_key[slot] = cid
        ht_val[slot] = i
        i += 1
    }

    $ord_cid := []int{}
    $ord_cat := []int{}
    $ord_amt := []int{}
    $ord_status := []int{}
    i = 0
    while i < n_ord {
        rng = (rng * 1103515245 + 12345) & 2147483647
        if (rng % 20) < 17 {
            rng = (rng * 1103515245 + 12345) & 2147483647
            ord_cid.push(cust_id[rng % n_cust])
        } else {
            rng = (rng * 1103515245 + 12345) & 2147483647
            ord_cid.push(9000000 + (rng % 50000))
        }
        rng = (rng * 1103515245 + 12345) & 2147483647
        ord_cat.push(rng % 32)
        rng = (rng * 1103515245 + 12345) & 2147483647
        ord_amt.push(100 + (rng % 2000))
        rng = (rng * 1103515245 + 12345) & 2147483647
        if (rng % 5) != 0 {
            ord_status.push(1)
        } else {
            ord_status.push(0)
        }
        i += 1
    }

    $grp_cnt := []int{}
    $grp_rev := []int{}
    $active := []int{}
    i = 0
    while i < 512 {
        grp_cnt.push(0)
        grp_rev.push(0)
        active.push(0)
        i += 1
    }

    $total_rows := 0
    $ck := 0
    $rnd := 0
    while rnd < 16 {
        min_amt := 350 + rnd * 50
        $b := 0
        while b < 512 {
            grp_cnt[b] = 0
            grp_rev[b] = 0
            b += 1
        }
        i = 0
        while i < n_ord {
            if ord_status[i] != 1 {
                i += 1
                ->
            }
            amt := ord_amt[i]
            if amt < min_amt {
                i += 1
                ->
            }
            cid := ord_cid[i]
            $slot := ((cid * 2654435761) >> 16) & ht_mask
            $found := -1
            while ht_key[slot] != -1 {
                if ht_key[slot] == cid {
                    found = ht_val[slot]
                    <-
                }
                slot = (slot + 1) & ht_mask
            }
            if found == -1 {
                i += 1
                ->
            }
            tier := cust_tier[found]
            if tier == 0 {
                i += 1
                ->
            }
            gb := cust_reg[found] * 32 + ord_cat[i]
            grp_cnt[gb] += 1
            grp_rev[gb] += amt * tier
            total_rows += 1
            i += 1
        }

        $acnt := 0
        b = 0
        while b < 512 {
            if grp_cnt[b] > 0 {
                active[acnt] = b
                acnt += 1
            }
            b += 1
        }
        i = 1
        while i < acnt {
            kb := active[i]
            kr := grp_rev[kb]
            $j := i - 1
            while j >= 0 {
                jb := active[j]
                jr := grp_rev[jb]
                if jr < kr || (jr == kr && jb > kb) {
                    active[j + 1] = jb
                    j -= 1
                } else {
                    <-
                }
            }
            active[j + 1] = kb
            i += 1
        }
        i = 0
        while i < acnt {
            gb := active[i]
            row := (gb * 1000003 + grp_cnt[gb] * 97 + (grp_rev[gb] % mod_v)) % mod_v
            ck = (ck * 31 + row) % mod_v
            i += 1
        }
        rnd += 1
    }

    println(total_rows)
    println(ck)
    << 0
}
