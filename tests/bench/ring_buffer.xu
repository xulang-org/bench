@main

struct Deque {
    pub buf []int
    pub head int
    pub tail int
    pub count int
    pub mask int
}

fn new_deque() Deque {
    $b := []int{}
    $i := 0
    while i < 16 {
        b.push(0)
        i += 1
    }
    << Deque{buf: b, head: 0, tail: 0, count: 0, mask: 15}
}

fn (d $&Deque) grow() {
    old_cap := d.mask + 1
    new_cap := old_cap * 2
    $new_buf := []int{}
    $i := 0
    while i < new_cap {
        new_buf.push(0)
        i += 1
    }
    old_mask := d.mask
    $j := 0
    while j < d.count {
        new_buf[j] = d.buf[(d.head + j) & old_mask]
        j += 1
    }
    d.buf = new_buf
    d.head = 0
    d.tail = d.count
    d.mask = new_cap - 1
}

fn deque_push_back(d $&Deque, val int) {
    if d.count == d.mask + 1 {
        d.grow()
    }
    d.buf[d.tail] = val
    d.tail = (d.tail + 1) & d.mask
    d.count += 1
}

fn deque_push_front(d $&Deque, val int) {
    if d.count == d.mask + 1 {
        d.grow()
    }
    d.head = (d.head - 1) & d.mask
    d.buf[d.head] = val
    d.count += 1
}

fn deque_pop_front(d $&Deque) int {
    if d.count == 0 {
        << 0
    }
    val := d.buf[d.head]
    d.head = (d.head + 1) & d.mask
    d.count -= 1
    << val
}

fn deque_pop_back(d $&Deque) int {
    if d.count == 0 {
        << 0
    }
    d.tail = (d.tail - 1) & d.mask
    val := d.buf[d.tail]
    d.count -= 1
    << val
}

fn (d $&Deque) push_back(val int) { deque_push_back(d, val) }
fn (d $&Deque) push_front(val int) { deque_push_front(d, val) }
fn (d $&Deque) pop_front() int { << deque_pop_front(d) }
fn (d $&Deque) pop_back() int { << deque_pop_back(d) }

fn main() int {
    $q := new_deque()
    $seed := 123456789
    $checksum := 0
    $i := 0
    while i < 5000000 {
        seed = (seed * 1664525 + 1013904223) % 2147483647
        op := seed & 3
        if op == 0 {
            deque_push_back($&q, seed)
        } else if op == 1 {
            deque_push_front($&q, seed)
        } else if op == 2 {
            v := deque_pop_front($&q)
            checksum = (checksum * 33 + v) % 1000000007
        } else {
            v := deque_pop_back($&q)
            checksum = (checksum * 33 + v) % 1000000007
        }
        i += 1
    }

    while q.count > 0 {
        v := deque_pop_front($&q)
        checksum = (checksum * 33 + v) % 1000000007
    }

    println(checksum)
    << 0
}
