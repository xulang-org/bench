@main

struct Sorter {
    pub a []int
}

fn (s &mut Sorter) qsort(low int, high int) {
    if low >= high {
        <<
    }
    pivot := s.a[(low + high) / 2]
    mut i := low
    mut j := high
    while i <= j {
        while s.a[i] < pivot {
            i += 1
        }
        while s.a[j] > pivot {
            j -= 1
        }
        if i <= j {
            tmp := s.a[i]
            s.a[i] = s.a[j]
            s.a[j] = tmp
            i += 1
            j -= 1
        }
    }
    if low < j {
        s.qsort(low, j)
    }
    if i < high {
        s.qsort(i, high)
    }
}

fn main() int {
    mut checksum := 0
    mut round := 0
    while round < 5 {
        mut arr := []int{}
        mut seed := 123456789 + round * 1013904223
        mut k := 0
        while k < 100000 {
            seed = (seed * 1664525 + 1013904223) % 2147483647
            arr.push(seed)
            k += 1
        }
        mut s := Sorter{a: arr}
        s.qsort(0, s.a.len - 1)
        mut i := 0
        while i < s.a.len {
            checksum = (checksum * 31 + s.a[i]) % 1000000007
            i += 1
        }
        round += 1
    }
    println(checksum)
    << 0
}
