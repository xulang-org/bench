@main

// Nested loops: 8000×8000 integer mul + mask. Conventional 2D iteration.
// checksum: 32572980224
fn main() int {
    $s := 0
    $i := 0
    while i < 8000 {
        $j := 0
        while j < 8000 {
            s += (i * j) & 1023
            j += 1
        }
        i += 1
    }
    println(s)
    << 0
}
