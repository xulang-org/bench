@main

struct BPlusTree {
    pub is_leaf []int
    pub nkeys []int
    pub next_leaf []int
    pub keys []int
    pub vals []int
    pub children []int
    pub path_node []int
    pub path_idx []int
    pub root int
}

fn alloc_node(t $&BPlusTree, leaf int) int {
    u := t.is_leaf.len
    t.is_leaf.push(leaf)
    t.nkeys.push(0)
    t.next_leaf.push(-1)
    $j := 0
    while j < 32 {
        t.keys.push(0)
        t.vals.push(0)
        j += 1
    }
    $c := 0
    while c < 33 {
        t.children.push(-1)
        c += 1
    }
    << u
}

fn new_btree() BPlusTree {
    $t := BPlusTree{
        is_leaf: []int{},
        nkeys: []int{},
        next_leaf: []int{},
        keys: []int{},
        vals: []int{},
        children: []int{},
        path_node: []int{},
        path_idx: []int{},
        root: 0
    }
    $d := 0
    while d < 16 {
        t.path_node.push(0)
        t.path_idx.push(0)
        d += 1
    }
    t.root = alloc_node($&t, 1)
    << t
}

fn descend_leaf(t &BPlusTree, k int) int {
    $u := t.root
    while t.is_leaf[u] == 0 {
        base := u * 32
        $lo := 0
        $hi := t.nkeys[u]
        while lo < hi {
            mid := (lo + hi) >> 1
            if t.keys[base + mid] <= k {
                lo = mid + 1
            } else {
                hi = mid
            }
        }
        u = t.children[u * 33 + lo]
    }
    << u
}

fn bt_insert(t $&BPlusTree, k int, v int) {
    $u := t.root
    $depth := 0
    while t.is_leaf[u] == 0 {
        base := u * 32
        $lo := 0
        $hi := t.nkeys[u]
        while lo < hi {
            mid := (lo + hi) >> 1
            if t.keys[base + mid] <= k {
                lo = mid + 1
            } else {
                hi = mid
            }
        }
        t.path_node[depth] = u
        t.path_idx[depth] = lo
        depth += 1
        u = t.children[u * 33 + lo]
    }

    base := u * 32
    $n := t.nkeys[u]
    $lo := 0
    $hi := n
    while lo < hi {
        mid := (lo + hi) >> 1
        if t.keys[base + mid] < k {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    if lo < n && t.keys[base + lo] == k {
        t.vals[base + lo] = v
        <<
    }
    $j := n
    while j > lo {
        t.keys[base + j] = t.keys[base + j - 1]
        t.vals[base + j] = t.vals[base + j - 1]
        j -= 1
    }
    t.keys[base + lo] = k
    t.vals[base + lo] = v
    n += 1
    t.nkeys[u] = n
    if n < 32 {
        <<
    }

    r := alloc_node(t, 1)
    rbase := r * 32
    j = 0
    while j < 16 {
        t.keys[rbase + j] = t.keys[base + 16 + j]
        t.vals[rbase + j] = t.vals[base + 16 + j]
        j += 1
    }
    t.nkeys[u] = 16
    t.nkeys[r] = 16
    t.next_leaf[r] = t.next_leaf[u]
    t.next_leaf[u] = r
    $up_key := t.keys[rbase]
    $up_right := r

    $d := depth - 1
    while d >= 0 {
        p := t.path_node[d]
        ins := t.path_idx[d]
        pbase := p * 32
        pcbase := p * 33
        $pn := t.nkeys[p]
        $k_idx := pn
        while k_idx > ins {
            t.keys[pbase + k_idx] = t.keys[pbase + k_idx - 1]
            t.children[pcbase + k_idx + 1] = t.children[pcbase + k_idx]
            k_idx -= 1
        }
        t.keys[pbase + ins] = up_key
        t.children[pcbase + ins + 1] = up_right
        pn += 1
        t.nkeys[p] = pn
        if pn < 32 {
            <<
        }
        nr := alloc_node(t, 0)
        nrbase := nr * 32
        nrcbase := nr * 33
        mid_key := t.keys[pbase + 16]
        $m := 0
        while m < 15 {
            t.keys[nrbase + m] = t.keys[pbase + 17 + m]
            m += 1
        }
        $c := 0
        while c < 16 {
            t.children[nrcbase + c] = t.children[pcbase + 17 + c]
            c += 1
        }
        t.nkeys[p] = 16
        t.nkeys[nr] = 15
        up_key = mid_key
        up_right = nr
        d -= 1
    }

    new_root := alloc_node(t, 0)
    t.keys[new_root * 32] = up_key
    t.children[new_root * 33] = t.root
    t.children[new_root * 33 + 1] = up_right
    t.nkeys[new_root] = 1
    t.root = new_root
}

fn bt_lookup(t &BPlusTree, k int) int {
    u := descend_leaf(t, k)
    base := u * 32
    n := t.nkeys[u]
    $lo := 0
    $hi := n
    while lo < hi {
        mid := (lo + hi) >> 1
        if t.keys[base + mid] < k {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    if lo < n && t.keys[base + lo] == k {
        << t.vals[base + lo]
    }
    << -1
}

fn main() int {
    mod_v := 1000000007
    $t := new_btree()
    $rng := 123456789

    $i := 0
    while i < 80000 {
        rng = (rng * 1103515245 + 12345) & 2147483647
        k := rng % 1000000
        rng = (rng * 1103515245 + 12345) & 2147483647
        v := (i * 17 + (rng & 1023)) % 1000000
        bt_insert($&t, k, v)
        i += 1
    }

    $hits := 0
    $ck := 0
    $q := 0
    while q < 120000 {
        rng = (rng * 1103515245 + 12345) & 2147483647
        k := rng % 1000000
        v := bt_lookup(&t, k)
        if v >= 0 {
            hits += 1
            ck = (ck * 31 + v) % mod_v
        }
        q += 1
    }

    $rcnt := 0
    $r := 0
    while r < 2000 {
        rng = (rng * 1103515245 + 12345) & 2147483647
        lo_k := rng % 999000
        hi_k := lo_k + 1000
        $u := descend_leaf(&t, lo_k)
        base0 := u * 32
        n0 := t.nkeys[u]
        $lo := 0
        $hi := n0
        while lo < hi {
            mid := (lo + hi) >> 1
            if t.keys[base0 + mid] < lo_k {
                lo = mid + 1
            } else {
                hi = mid
            }
        }
        $cnt := 0
        $s := 0
        $idx := lo
        while u != -1 {
            base := u * 32
            n := t.nkeys[u]
            $j := idx
            $done := 0
            while j < n {
                if t.keys[base + j] > hi_k {
                    done = 1
                    <-
                }
                cnt += 1
                s = (s + t.vals[base + j]) % mod_v
                j += 1
            }
            if done == 1 {
                <-
            }
            u = t.next_leaf[u]
            idx = 0
        }
        rcnt += cnt
        ck = (ck * 37 + s + cnt) % mod_v
        r += 1
    }

    println(hits + rcnt)
    println(ck)
    << 0
}
