@main

#math

struct SciRandom {
    pub m []int
    pub idx_i int
    pub idx_j int
}

fn new_random(seed int) SciRandom {
    m1 := 2147483647
    m2 := 65536
    $m := []int{}
    $k := 0
    while k < 17 {
        m.push(0)
        k += 1
    }
    $jseed := seed
    if jseed < 0 {
        jseed = 0 - jseed
    }
    if jseed > m1 {
        jseed = m1
    }
    if jseed % 2 == 0 {
        jseed -= 1
    }
    k0 := 9069 % m2
    k1 := 9069 / m2
    $j0 := jseed % m2
    $j1 := jseed / m2
    $iloop := 0
    while iloop < 17 {
        jseed = j0 * k0
        j1 = (jseed / m2 + j0 * k1 + j1 * k0) % (m2 / 2)
        j0 = jseed % m2
        m[iloop] = j0 + m2 * j1
        iloop += 1
    }
    << SciRandom{m: m, idx_i: 4, idx_j: 16}
}

fn (r $&SciRandom) next_double() f64 {
    m1 := 2147483647
    dm1 := 1.0 / 2147483647.0
    $k := r.m[r.idx_i] - r.m[r.idx_j]
    if k < 0 {
        k += m1
    }
    r.m[r.idx_j] = k
    if r.idx_i == 0 {
        r.idx_i = 16
    } else {
        r.idx_i -= 1
    }
    if r.idx_j == 0 {
        r.idx_j = 16
    } else {
        r.idx_j -= 1
    }
    << dm1 * f64(k)
}

fn main() int {
    n := 100
    $rng := new_random(101010)
    $a0 := []f64{}
    $a := []f64{}
    $piv := []int{}
    $idx := 0
    while idx < n * n {
        a0.push(rng.next_double())
        a.push(0.0)
        idx += 1
    }
    idx = 0
    while idx < n {
        piv.push(0)
        idx += 1
    }

    $lu_acc := 0.0
    $piv_chk := 0
    $rep := 0
    while rep < 30 {
        idx = 0
        while idx < n * n {
            a[idx] = a0[idx]
            idx += 1
        }
        $j := 0
        while j < n {
            $jp := j
            $t := math.abs(a[j * n + j])
            $i := j + 1
            while i < n {
                ab := math.abs(a[i * n + j])
                if ab > t {
                    jp = i
                    t = ab
                }
                i += 1
            }
            piv[j] = jp
            if jp != j {
                $k := 0
                while k < n {
                    tmp := a[j * n + k]
                    a[j * n + k] = a[jp * n + k]
                    a[jp * n + k] = tmp
                    k += 1
                }
            }
            if j < n - 1 {
                recp := 1.0 / a[j * n + j]
                $k := j + 1
                while k < n {
                    a[k * n + j] = a[k * n + j] * recp
                    k += 1
                }
                $ii := j + 1
                while ii < n {
                    aii := a[ii * n + j]
                    $jj := j + 1
                    while jj < n {
                        a[ii * n + jj] -= aii * a[j * n + jj]
                        jj += 1
                    }
                    ii += 1
                }
            }
            j += 1
        }
        idx = 0
        while idx < n * n {
            lu_acc += math.abs(a[idx])
            idx += 1
        }
        $ps := 0
        idx = 0
        while idx < n {
            ps += piv[idx]
            idx += 1
        }
        piv_chk = (piv_chk + ps) % 1000000007
        rep += 1
    }
    println(int(math.floor(lu_acc * 100.0 + 0.5)) + piv_chk)
    << 0
}
