            while bi < 32 {
                dk[bi] = dk[bi] ^ u_buf[bi]
                bi += 1
            }
            it += 1
        }
        bi = 0
        while bi < 32 {
            acc[bi] = acc[bi] ^ dk[bi]
            bi += 1
        }
        ops += 1
        i += 1
    }

    i = 0
    while i < 200 {
        key = []int{}
        push_lit($&key, "jwt-hmac-key-")
        push_2d($&key, i % 16)

        msg = []int{}
        push_lit($&msg, "eyJhbGciOiJIUzI1NiJ9.sub=user_")
        push_4d($&msg, i)
        push_lit($&msg, "&seq=")
        push_5d($&msg, i * 37)

        hmac_sha256(&key, key.len, &msg, msg.len, $&ipad, $&opad, $&inner_buf, $&outer_buf, $&inner_hash, $&state, $&pad, $&w, &kv, &iv, $&u_buf)
        $bi := 0
        while bi < 32 {
            acc[bi] = acc[bi] ^ u_buf[bi]
            bi += 1
        }
        ops += 1
        i += 1
    }

    println(ops)
    $hb := strings.builder()
    $hi := 0
    while hi < 32 {
        v := acc[hi]
        h1 := (v >> 4) & 15
        h2 := v & 15
        if h1 < 10 {
            hb.write_byte(48 + h1)
        } else {
            hb.write_byte(87 + h1)
        }
        if h2 < 10 {
            hb.write_byte(48 + h2)
        } else {
            hb.write_byte(87 + h2)
        }
        hi += 1
    }
    println(hb.text())
    << 0
}
