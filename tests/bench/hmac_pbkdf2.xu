@main

#strings

fn rotr32(x int, n int) int {
    << ((x >> n) | ((x << (32 - n)) & 4294967295)) & 4294967295
}

fn sha256_block(state $&[]int, blk &[]int, off int, w $&[]int, kv &[]int) {
    $t := 0
    while t < 16 {
        j := off + t * 4
        w[t] = (blk[j] << 24) | (blk[j + 1] << 16) | (blk[j + 2] << 8) | blk[j + 3]
        t += 1
    }
    while t < 64 {
        w15 := w[t - 15]
        w2 := w[t - 2]
        s0 := rotr32(w15, 7) ^ rotr32(w15, 18) ^ (w15 >> 3)
        s1 := rotr32(w2, 17) ^ rotr32(w2, 19) ^ (w2 >> 10)
        w[t] = (w[t - 16] + s0 + w[t - 7] + s1) & 4294967295
        t += 1
    }
    $a := state[0]
    $b := state[1]
    $c := state[2]
    $d := state[3]
    $e := state[4]
    $f := state[5]
    $g := state[6]
    $h := state[7]
    t = 0
    while t < 64 {
        bs1 := rotr32(e, 6) ^ rotr32(e, 11) ^ rotr32(e, 25)
        ch := (e & f) ^ ((e ^ 4294967295) & g)
        temp1 := (h + bs1 + ch + kv[t] + w[t]) & 4294967295
        bs0 := rotr32(a, 2) ^ rotr32(a, 13) ^ rotr32(a, 22)
        maj := (a & b) ^ (a & c) ^ (b & c)
        temp2 := (bs0 + maj) & 4294967295
        h = g
        g = f
        f = e
        e = (d + temp1) & 4294967295
        d = c
        c = b
        b = a
        a = (temp1 + temp2) & 4294967295
        t += 1
    }
    state[0] = (state[0] + a) & 4294967295
    state[1] = (state[1] + b) & 4294967295
    state[2] = (state[2] + c) & 4294967295
    state[3] = (state[3] + d) & 4294967295
    state[4] = (state[4] + e) & 4294967295
    state[5] = (state[5] + f) & 4294967295
    state[6] = (state[6] + g) & 4294967295
    state[7] = (state[7] + h) & 4294967295
}

fn sha256_compute(msg &[]int, mlen int, state $&[]int, pad $&[]int, w $&[]int, kv &[]int, iv &[]int, out $&[]int) {
    $i := 0
    while i < 8 {
        state[i] = iv[i]
        i += 1
    }
    $pos := 0
    while pos + 64 <= mlen {
        sha256_block(state, msg, pos, w, kv)
        pos += 64
    }
    rem := mlen - pos
    $pi := 0
    while pi < rem {
        pad[pi] = msg[pos + pi]
        pi += 1
    }
    pad[rem] = 128
    pi = rem + 1
    $total_len := 64
    if rem >= 56 {
        total_len = 128
    }
    while pi < total_len - 8 {
        pad[pi] = 0
        pi += 1
    }
    bitlen := mlen * 8
    $bi := 0
    while bi < 8 {
        pad[total_len - 8 + bi] = (bitlen >> ((7 - bi) * 8)) & 255
        bi += 1
    }
    sha256_block(state, pad, 0, w, kv)
    if total_len == 128 {
        sha256_block(state, pad, 64, w, kv)
    }
    i = 0
    while i < 8 {
        sv := state[i]
        out[i * 4] = (sv >> 24) & 255
        out[i * 4 + 1] = (sv >> 16) & 255
        out[i * 4 + 2] = (sv >> 8) & 255
        out[i * 4 + 3] = sv & 255
        i += 1
    }
}

fn hmac_sha256(
    key &[]int, klen int,
    msg &[]int, mlen int,
    ipad $&[]int, opad $&[]int,
    inner_buf $&[]int, outer_buf $&[]int,
    inner_hash $&[]int,
    state $&[]int, pad $&[]int, w $&[]int, kv &[]int, iv &[]int,
    out $&[]int
) {
    $i := 0
    while i < 64 {
        $kb := 0
        if i < klen {
            kb = key[i]
        }
        ipad[i] = kb ^ 54
        opad[i] = kb ^ 92
        inner_buf[i] = ipad[i]
        outer_buf[i] = opad[i]
        i += 1
    }
    i = 0
    while i < mlen {
        inner_buf[64 + i] = msg[i]
        i += 1
    }
    sha256_compute(inner_buf, 64 + mlen, state, pad, w, kv, iv, inner_hash)
    i = 0
    while i < 32 {
        outer_buf[64 + i] = inner_hash[i]
        i += 1
    }
    sha256_compute(outer_buf, 96, state, pad, w, kv, iv, out)
}

fn push_4d(buf $&[]int, v int) {
    buf.push(48 + ((v / 1000) % 10))
    buf.push(48 + ((v / 100) % 10))
    buf.push(48 + ((v / 10) % 10))
    buf.push(48 + (v % 10))
}

fn push_3d(buf $&[]int, v int) {
    buf.push(48 + ((v / 100) % 10))
    buf.push(48 + ((v / 10) % 10))
    buf.push(48 + (v % 10))
}

fn push_2d(buf $&[]int, v int) {
    buf.push(48 + ((v / 10) % 10))
    buf.push(48 + (v % 10))
}

fn push_5d(buf $&[]int, v int) {
    buf.push(48 + ((v / 10000) % 10))
    buf.push(48 + ((v / 1000) % 10))
    buf.push(48 + ((v / 100) % 10))
    buf.push(48 + ((v / 10) % 10))
    buf.push(48 + (v % 10))
}

fn push_lit(buf $&[]int, s string) {
    $i := 0
    while i < s.len {
        buf.push(s[i] & 255)
        i += 1
    }
}

