    $opad := []int{}
    $inner_buf := []int{}
    $outer_buf := []int{}
    $inner_hash := []int{}
    $dk := []int{}
    $u_buf := []int{}
    $u_in := []int{}
    $acc := []int{}

    $z := 0
    while z < 256 {
        inner_buf.push(0)
        outer_buf.push(0)
