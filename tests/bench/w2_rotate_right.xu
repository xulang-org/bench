@main

#math/bits

// W2 diagnostic: variable right rotation with loop-carried state.
fn main() int {
    mut x := 0x123456789abcdef0
    mut checksum := 0
    mut i := 0
    while i < 10000000 {
        x = bits.rotate_right(x ^ i, i & 63)
        checksum = checksum ^ x
        i += 1
    }
    println(str(x))
    println(str(checksum))
    << 0
}
