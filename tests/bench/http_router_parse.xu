@main

fn push_str(buf $&[]int, s string) {
    $i := 0
    while i < s.len {
        buf.push(s[i] & 255)
        i += 1
    }
}

fn push_int(buf $&[]int, v int) {
    $x := v
    if x < 0 {
        buf.push(45)
        x = -x
    }
    if x == 0 {
        buf.push(48)
        <<
    }
    $digs := []int{}
    $k := 0
    while k < 24 {
        digs.push(0)
        k += 1
    }
    $dc := 0
    while x > 0 {
        digs[dc] = 48 + (x % 10)
        dc += 1
        x /= 10
    }
    $i := dc - 1
    while i >= 0 {
        buf.push(digs[i])
        i -= 1
    }
}

fn hex_val(b int) int {
    if b >= 48 && b <= 57 {
        << b - 48
    }
    if b >= 65 && b <= 70 {
        << b - 55
    }
    if b >= 97 && b <= 102 {
        << b - 87
    }
    << -1
}

fn decode_pct_hash(buf &[]int, start int, end int) int {
    mod_v := 1000000007
    $h := 0
    $i := start
    while i < end {
        b := buf[i]
        $ch := b
        if b == 43 {
            ch = 32
            i += 1
        } else if b == 37 && i + 2 < end {
            hi := hex_val(buf[i + 1])
            lo := hex_val(buf[i + 2])
            if hi >= 0 && lo >= 0 {
                ch = (hi << 4) | lo
                i += 3
            } else {
                i += 1
            }
        } else {
            i += 1
        }
        h = (h * 131 + ch) % mod_v
    }
    << h
}

struct TrieRouter {
    node_edge_head []int
    node_param     []int
    node_wild      []int
    node_routes    []int
    edge_off       []int
    edge_len       []int
    edge_child     []int
    edge_next      []int
    seg_pool       []int
}

fn new_node(rt $&TrieRouter) int {
    idx := rt.node_edge_head.len
    rt.node_edge_head.push(-1)
    rt.node_param.push(-1)
    rt.node_wild.push(-1)
    $m := 0
    while m < 5 {
        rt.node_routes.push(0)
        m += 1
    }
    << idx
}

fn eq_slice_str(pool &[]int, off int, ln int, s string) bool {
    if ln != s.len {
        << false
    }
    $i := 0
    while i < ln {
        if pool[off + i] != (s[i] & 255) {
            << false
        }
        i += 1
    }
    << true
}

fn eq_buf_pool(buf &[]int, s int, ln int, pool &[]int, off int, plen int) bool {
    if ln != plen {
        << false
    }
    $i := 0
    while i < ln {
        if buf[s + i] != pool[off + i] {
            << false
        }
        i += 1
    }
    << true
}

fn add_route(rt $&TrieRouter, method int, pat &[]string, rid int) {
    $cur := 0
    $i := 0
    while i < pat.len {
        seg := pat[i]
        if seg == "*" {
            if rt.node_wild[cur] < 0 {
                nxt_node := new_node(rt)
                rt.node_wild[cur] = nxt_node
            }
            cur = rt.node_wild[cur]
        } else if seg.len > 0 && seg[0] == 58 {
            if rt.node_param[cur] < 0 {
                nxt_node := new_node(rt)
                rt.node_param[cur] = nxt_node
            }
            cur = rt.node_param[cur]
        } else {
            $e := rt.node_edge_head[cur]
            $found := -1
            while e >= 0 {
                if eq_slice_str(&rt.seg_pool, rt.edge_off[e], rt.edge_len[e], seg) {
                    found = e
                    <-
                }
                e = rt.edge_next[e]
            }
            if found >= 0 {
                cur = rt.edge_child[found]
            } else {
                nxt_node := new_node(rt)
                off := rt.seg_pool.len
                $j := 0
                while j < seg.len {
                    rt.seg_pool.push(seg[j] & 255)
                    j += 1
                }
                ei := rt.edge_off.len
                rt.edge_off.push(off)
                rt.edge_len.push(seg.len)
                rt.edge_child.push(nxt_node)
                rt.edge_next.push(rt.node_edge_head[cur])
                rt.node_edge_head[cur] = ei
                cur = nxt_node
            }
        }
        i += 1
    }
    rt.node_routes[cur * 5 + method] = rid
}

fn match_content_length(buf &[]int, s int, e int) bool {
    if e - s != 14 {
        << false
    }
    t := "content-length"
    $i := 0
    while i < 14 {
        $c := buf[s + i]
        if c >= 65 && c <= 90 {
            c += 32
        }
        if c != (t[i] & 255) {
            << false
        }
        i += 1
    }
    << true
}

fn match_request_id(buf &[]int, s int, e int) bool {
    if e - s != 12 {
        << false
    }
    t := "x-request-id"
    $i := 0
    while i < 12 {
        $c := buf[s + i]
        if c >= 65 && c <= 90 {
            c += 32
        }
        if c != (t[i] & 255) {
            << false
        }
        i += 1
    }
    << true
}

fn main() int {
    mod_v := 1000000007
    $rt := TrieRouter{
        node_edge_head: []int{},
        node_param: []int{},
        node_wild: []int{},
        node_routes: []int{},
        edge_off: []int{},
        edge_len: []int{},
        edge_child: []int{},
        edge_next: []int{},
        seg_pool: []int{}
    }
    _ := new_node($&rt)

    $r1 := []string{}
    r1.push("health")
    add_route($&rt, 1, &r1, 1)
    $r2 := []string{}
    r2.push("metrics")
    add_route($&rt, 1, &r2, 2)
    $r3 := []string{}
    r3.push("api")
    r3.push("v1")
    r3.push("users")
    r3.push(":id")
    add_route($&rt, 1, &r3, 3)
    $r4 := []string{}
    r4.push("api")
    r4.push("v1")
    r4.push("users")
    add_route($&rt, 2, &r4, 4)
    $r5 := []string{}
    r5.push("api")
    r5.push("v1")
    r5.push("users")
    r5.push(":id")
    r5.push("posts")
    r5.push(":pid")
    add_route($&rt, 1, &r5, 5)
    $r6 := []string{}
    r6.push("api")
    r6.push("v1")
    r6.push("users")
    r6.push(":id")
    r6.push("posts")
    r6.push(":pid")
    add_route($&rt, 4, &r6, 6)
    $r7 := []string{}
    r7.push("api")
    r7.push("v1")
    r7.push("orders")
    r7.push(":oid")
    r7.push("items")
    add_route($&rt, 1, &r7, 7)
    $r8 := []string{}
    r8.push("api")
    r8.push("v1")
    r8.push("orders")
    r8.push(":oid")
    r8.push("status")
    add_route($&rt, 3, &r8, 8)
    $r9 := []string{}
    r9.push("api")
    r9.push("v1")
    r9.push("orgs")
    r9.push(":org")
    r9.push("repos")
    r9.push(":repo")
    r9.push("issues")
    r9.push(":num")
    add_route($&rt, 1, &r9, 9)
    $r10 := []string{}
    r10.push("api")
    r10.push("v1")
    r10.push("orgs")
    r10.push(":org")
    r10.push("repos")
    r10.push(":repo")
    r10.push("issues")
    add_route($&rt, 2, &r10, 10)
    $r11 := []string{}
    r11.push("api")
    r11.push("v2")
    r11.push("search")
    add_route($&rt, 1, &r11, 11)
    $r12 := []string{}
    r12.push("static")
    r12.push("*")
    add_route($&rt, 1, &r12, 12)

    $users := []string{}
    users.push("alice")
    users.push("bob42")
    users.push("charlie")
    users.push("dana_9")
    users.push("eve")
    users.push("frank01")
    users.push("grace")
    users.push("heidi")

    $orgs := []string{}
    orgs.push("xulang")
    orgs.push("acme")
    orgs.push("nebula")
    orgs.push("kernel")

    $repos := []string{}
    repos.push("xu")
    repos.push("bench")
    repos.push("runtime")
    repos.push("stdlib")
    repos.push("docs")

    $queries := []string{}
    queries.push("page=2&limit=50&q=hello+world%21")
    queries.push("sort=desc&filter=open%2Factive&tag=v1%2E0")
    queries.push("q=%41%42%43+test%20case&offset=100")
    queries.push("")
    queries.push("lang=zh%2DCN&mode=fast&debug=1")
    queries.push("path=%2Fusr%2Fbin&retry=3")

    $req_buf := []int{}
    $req_off := []int{}
    $req_len := []int{}
    $rng := 246813579
    $i := 0
    while i < 240 {
        rng = (rng * 1103515245 + 12345) & 2147483647
        k := rng % 14
        rng = (rng * 1103515245 + 12345) & 2147483647
        u := users[rng % 8]
        rng = (rng * 1103515245 + 12345) & 2147483647
        pid := 100 + (rng % 900)
        rng = (rng * 1103515245 + 12345) & 2147483647
        oid := 10000 + (rng % 90000)
        rng = (rng * 1103515245 + 12345) & 2147483647
        org := orgs[rng % 4]
        rng = (rng * 1103515245 + 12345) & 2147483647
        repo := repos[rng % 5]
        rng = (rng * 1103515245 + 12345) & 2147483647
        num := 1 + (rng % 500)
        rng = (rng * 1103515245 + 12345) & 2147483647
        q := queries[rng % 6]
        rng = (rng * 1103515245 + 12345) & 2147483647
        cl := rng % 4096

        off := req_buf.len
        req_off.push(off)

        if k == 0 {
            push_str($&req_buf, "GET /health")
        } else if k == 1 {
            push_str($&req_buf, "GET /metrics")
        } else if k == 2 {
            push_str($&req_buf, "GET /api/v1/users/")
            push_str($&req_buf, u)
        } else if k == 3 {
            push_str($&req_buf, "POST /api/v1/users")
        } else if k == 4 {
            push_str($&req_buf, "GET /api/v1/users/")
            push_str($&req_buf, u)
            push_str($&req_buf, "/posts/")
            push_int($&req_buf, pid)
        } else if k == 5 {
            push_str($&req_buf, "DELETE /api/v1/users/")
            push_str($&req_buf, u)
            push_str($&req_buf, "/posts/")
            push_int($&req_buf, pid)
        } else if k == 6 {
            push_str($&req_buf, "GET /api/v1/orders/")
            push_int($&req_buf, oid)
            push_str($&req_buf, "/items")
        } else if k == 7 {
            push_str($&req_buf, "PUT /api/v1/orders/")
            push_int($&req_buf, oid)
            push_str($&req_buf, "/status")
        } else if k == 8 {
            push_str($&req_buf, "GET /api/v1/orgs/")
            push_str($&req_buf, org)
            push_str($&req_buf, "/repos/")
            push_str($&req_buf, repo)
            push_str($&req_buf, "/issues/")
            push_int($&req_buf, num)
        } else if k == 9 {
            push_str($&req_buf, "POST /api/v1/orgs/")
            push_str($&req_buf, org)
            push_str($&req_buf, "/repos/")
            push_str($&req_buf, repo)
            push_str($&req_buf, "/issues")
        } else if k == 10 {
            push_str($&req_buf, "GET /api/v2/search")
        } else if k == 11 {
            push_str($&req_buf, "GET /static/js/")
            push_str($&req_buf, repo)
            push_str($&req_buf, "/bundle_")
            push_int($&req_buf, pid)
            push_str($&req_buf, ".js")
        } else if k == 12 {
            push_str($&req_buf, "GET /api/v1/unknown/")
            push_str($&req_buf, u)
            push_str($&req_buf, "/nope")
        } else {
            push_str($&req_buf, "POST /health")
        }

        if q.len > 0 {
            req_buf.push(63)
            push_str($&req_buf, q)
        }
        push_str($&req_buf, " HTTP/1.1\r\n")
        if (i % 3) != 0 {
            push_str($&req_buf, "Host: api.xulang.org\r\n")
        } else {
            push_str($&req_buf, "HOST: api.xulang.org\r\n")
        }
        push_str($&req_buf, "User-Agent: xu-bench/1.0\r\n")
        if (i & 1) == 0 {
            push_str($&req_buf, "Content-Length: ")
        } else {
            push_str($&req_buf, "content-length: ")
        }
        push_int($&req_buf, cl)
        push_str($&req_buf, "\r\nX-Request-Id: req-")
        push_int($&req_buf, i)
        req_buf.push(45)
        push_int($&req_buf, num)
        push_str($&req_buf, "\r\n\r\n")
        req_len.push(req_buf.len - off)
        i += 1
    }

    $seg_starts := []int{}
    $seg_ends := []int{}
    $k_init := 0
    while k_init < 16 {
        seg_starts.push(0)
        seg_ends.push(0)
        k_init += 1
    }

    $matched := 0
    $ck := 0
    $rnd := 0
    while rnd < 500 {
        $ri := 0
        while ri < 240 {
            r_start := req_off[ri]
            r_end := r_start + req_len[ri]

            $sp1 := r_start
            while req_buf[sp1] != 32 {
                sp1 += 1
            }
            mlen := sp1 - r_start
            $mc := 0
            if mlen == 3 && req_buf[r_start] == 71 {
                mc = 1
            } else if mlen == 4 && req_buf[r_start] == 80 {
                mc = 2
            } else if mlen == 3 && req_buf[r_start] == 80 {
                mc = 3
            } else if mlen == 6 && req_buf[r_start] == 68 {
                mc = 4
            }

            t_start := sp1 + 1
            $sp2 := t_start
            while req_buf[sp2] != 32 {
                sp2 += 1
            }
            $crlf := sp2 + 1
            while !(req_buf[crlf] == 13 && req_buf[crlf + 1] == 10) {
                crlf += 1
            }

            $qpos := -1
            $p := t_start
            while p < sp2 {
                if req_buf[p] == 63 {
                    qpos = p
                    <-
                }
                p += 1
            }
            $path_end := sp2
            if qpos >= 0 {
                path_end = qpos
            }

            $n_segs := 0
            $sp := t_start
            while sp < path_end {
                while sp < path_end && req_buf[sp] == 47 {
                    sp += 1
                }
                if sp >= path_end {
                    <-
                }
                $se := sp
                while se < path_end && req_buf[se] != 47 {
                    se += 1
                }
                seg_starts[n_segs] = sp
                seg_ends[n_segs] = se
                n_segs += 1
                sp = se
            }

            $pos := crlf + 2
            $hdr_cnt := 0
            $content_len := 0
            $req_id_hash := 0
            while pos < r_end {
                $lend := pos
                while lend + 1 < r_end && !(req_buf[lend] == 13 && req_buf[lend + 1] == 10) {
                    lend += 1
                }
                if lend == pos {
                    <-
                }
                $col := pos
                while col < lend && req_buf[col] != 58 {
                    col += 1
                }
                $vs := col + 1
                while vs < lend && (req_buf[vs] == 32 || req_buf[vs] == 9) {
                    vs += 1
                }
                $ve := lend
                while ve > vs && (req_buf[ve - 1] == 32 || req_buf[ve - 1] == 9) {
                    ve -= 1
                }
                hdr_cnt += 1
                if match_content_length(&req_buf, pos, col) {
                    $v := 0
                    $vp := vs
                    while vp < ve {
                        v = v * 10 + (req_buf[vp] - 48)
                        vp += 1
                    }
                    content_len = v
                } else if match_request_id(&req_buf, pos, col) {
                    $vp := vs
                    while vp < ve {
                        req_id_hash = (req_id_hash * 31 + req_buf[vp]) % mod_v
                        vp += 1
                    }
                }
                pos = lend + 2
            }

            $cur := 0
            $ph := 0
            $sj := 0
            $dead := false
            while sj < n_segs {
                ss := seg_starts[sj]
                sln := seg_ends[sj] - ss
                $e := rt.node_edge_head[cur]
                $nxt := -1
                while e >= 0 {
                    if eq_buf_pool(&req_buf, ss, sln, &rt.seg_pool, rt.edge_off[e], rt.edge_len[e]) {
                        nxt = rt.edge_child[e]
                        <-
                    }
                    e = rt.edge_next[e]
                }
                if nxt >= 0 {
                    cur = nxt
                    sj += 1
                } else if rt.node_param[cur] >= 0 {
                    $cp := ss
                    ce := ss + sln
                    while cp < ce {
                        ph = (ph * 131 + req_buf[cp]) % mod_v
                        cp += 1
                    }
                    cur = rt.node_param[cur]
                    sj += 1
                } else if rt.node_wild[cur] >= 0 {
                    while sj < n_segs {
                        $cp := seg_starts[sj]
                        ce := seg_ends[sj]
                        while cp < ce {
                            ph = (ph * 131 + req_buf[cp]) % mod_v
                            cp += 1
                        }
                        sj += 1
                    }
                    cur = rt.node_wild[cur]
                    <-
                } else {
                    dead = true
                    <-
                }
            }
            $route_id := 0
            $param_hash := 0
            if !dead {
                rid := rt.node_routes[cur * 5 + mc]
                if rid > 0 {
                    route_id = rid
                    param_hash = ph
                }
            }

            $q_hash := 0
            if qpos >= 0 && qpos + 1 < sp2 {
                $qp := qpos + 1
                while qp < sp2 {
                    $qe := qp
                    while qe < sp2 && req_buf[qe] != 38 {
                        qe += 1
                    }
                    $eq := -1
                    $qt := qp
                    while qt < qe {
                        if req_buf[qt] == 61 {
                            eq = qt
                            <-
                        }
                        qt += 1
                    }
                    if eq >= 0 {
                        kh := decode_pct_hash(&req_buf, qp, eq)
                        vh := decode_pct_hash(&req_buf, eq + 1, qe)
                        q_hash = (q_hash * 257 + kh * 17 + vh) % mod_v
                    } else {
                        q_hash = (q_hash * 257 + decode_pct_hash(&req_buf, qp, qe)) % mod_v
                    }
                    qp = qe + 1
                }
            }

            if route_id > 0 {
                matched += 1
            }
            row := (route_id * 1000003 + mc * 97 + param_hash * 7 + q_hash * 13 + content_len * 3 + hdr_cnt * 19 + req_id_hash) % mod_v
            ck = (ck * 31 + row) % mod_v
            ri += 1
        }
        rnd += 1
    }
    println(matched)
    println(ck)
    << 0
}
