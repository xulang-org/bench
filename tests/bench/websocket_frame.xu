@main

fn main() int {
    mod_v := 1000000007
    $s_fin := []int{}
    $s_op := []int{}
    $s_m0 := []int{}
    $s_m1 := []int{}
    $s_m2 := []int{}
    $s_m3 := []int{}
    $s_len := []int{}
    $s_seed := []int{}

    $rng := 987654321
    $i := 0
    while i < 80 {
        tier := i % 4
        rng = (rng * 1103515245 + 12345) & 2147483647
        $ln := 0
        if tier == 0 {
            ln = 13 + (rng % 90)
        } else if tier == 1 {
            ln = 126 + (rng % 300)
        } else if tier == 2 {
            ln = 500 + (rng % 1500)
        } else {
            ln = 2000 + (rng % 2048)
        }
        $fin := 0
        if (i % 5) != 0 {
            fin = 1
        }
        $op := 1
        if (i & 1) == 0 {
            op = 2
        }
        rng = (rng * 1103515245 + 12345) & 2147483647
        m0 := (rng >> 8) & 255
        rng = (rng * 1103515245 + 12345) & 2147483647
        m1 := (rng >> 8) & 255
        rng = (rng * 1103515245 + 12345) & 2147483647
        m2 := (rng >> 8) & 255
        rng = (rng * 1103515245 + 12345) & 2147483647
        m3 := (rng >> 8) & 255
        rng = (rng * 1103515245 + 12345) & 2147483647
        seed := (rng >> 4) & 255

        s_fin.push(fin)
        s_op.push(op)
        s_m0.push(m0)
        s_m1.push(m1)
        s_m2.push(m2)
        s_m3.push(m3)
        s_len.push(ln)
        s_seed.push(seed)
        i += 1
    }

    $total_bytes := 0
    $ck := 0
    $rnd := 0
    while rnd < 180 {
        $wire := []int{}
        $idx := 0
        while idx < 80 {
            fin := s_fin[idx]
            op := s_op[idx]
            ln := s_len[idx]
            seed := s_seed[idx]
            m0 := (s_m0[idx] + rnd) & 255
            m1 := (s_m1[idx] + idx) & 255
            m2 := s_m2[idx]
            m3 := s_m3[idx]

            wire.push(((fin & 1) << 7) | (op & 15))
            if ln <= 125 {
                wire.push(128 | ln)
            } else {
                wire.push(128 | 126)
                wire.push((ln >> 8) & 255)
                wire.push(ln & 255)
            }
            wire.push(m0)
            wire.push(m1)
            wire.push(m2)
            wire.push(m3)

            $j := 0
            while j < ln {
                pb := (seed + j * 17 + rnd * 3) & 255
                $mk := m0
                rem := j & 3
                if rem == 1 {
                    mk = m1
                } else if rem == 2 {
                    mk = m2
                } else if rem == 3 {
                    mk = m3
                }
                wire.push(pb ^ mk)
                j += 1
            }
            idx += 1
        }

        $pos := 0
        wlen := wire.len
        while pos < wlen {
            b0 := wire[pos]
            b1 := wire[pos + 1]
            pos += 2
            fin := (b0 >> 7) & 1
            op := b0 & 15
            masked := (b1 >> 7) & 1
            $plen := b1 & 127
            if plen == 126 {
                plen = (wire[pos] << 8) | wire[pos + 1]
                pos += 2
            }
            $m0 := 0
            $m1 := 0
            $m2 := 0
            $m3 := 0
            if masked != 0 {
                m0 = wire[pos]
                m1 = wire[pos + 1]
                m2 = wire[pos + 2]
                m3 = wire[pos + 3]
                pos += 4
            }
            $fh := (fin * 17 + op) % mod_v
            $j := 0
            while j < plen {
                $mk := m0
                rem := j & 3
                if rem == 1 {
                    mk = m1
                } else if rem == 2 {
                    mk = m2
                } else if rem == 3 {
                    mk = m3
                }
                ch := wire[pos + j] ^ mk
                fh = (fh * 131 + ch) % mod_v
                j += 1
            }
            pos += plen
            total_bytes += plen
            ck = (ck * 31 + fh) % mod_v
        }
        rnd += 1
    }
    println(total_bytes)
    println(ck)
    << 0
}
