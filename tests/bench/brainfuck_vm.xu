@main

fn main() int {
    prog := ",+++++++++++++[>+++++++++++++++++++++++++++++++++++++[>+++++++++++++++++++++++++++++++[>+++++++++++++++++++[>+++>+++++<<-]<-]<-]>>>.>.<<<<<[>>>>+>>+<<<<<<-]>>>>>>[<<<<<<+>>>>>>-]<<.<<<<-]"
    $ops := []int{}
    $jmp := []int{}
    $st := []int{}
    $i := 0
    while i < prog.len {
        c := prog[i] & 255
        if c == 62 || c == 60 || c == 43 || c == 45 || c == 46 || c == 44 || c == 91 || c == 93 {
            ops.push(c)
            jmp.push(0)
            st.push(0)
            i += 1
        } else {
            i += 1
        }
    }
    n := ops.len
    $sp := 0
    i = 0
    while i < n {
        if ops[i] == 91 {
            st[sp] = i
            sp += 1
        } else if ops[i] == 93 {
            sp -= 1
            j := st[sp]
            jmp[j] = i
            jmp[i] = j
        }
        i += 1
    }

    $tape := []int{}
    i = 0
    while i < 30000 {
        tape.push(0)
        i += 1
    }

    $out_cnt := 0
    $s1 := 0
    $s2 := 0
    $seed := 1
    while seed <= 4 {
        $j := 0
        while j < 30000 {
            tape[j] = 0
            j += 1
        }
        $pc := 0
        $dp := 0
        $ip := 0
        while pc < n {
            op := ops[pc]
            if op == 62 {
                dp += 1
            } else if op == 60 {
                dp -= 1
            } else if op == 43 {
                tape[dp] = (tape[dp] + 1) & 255
            } else if op == 45 {
                tape[dp] = (tape[dp] + 255) & 255
            } else if op == 46 {
                b := tape[dp]
                out_cnt += 1
                s1 = (s1 + b) % 255
                s2 = (s2 + s1) % 255
            } else if op == 44 {
                if ip == 0 {
                    tape[dp] = seed
                    ip = 1
                } else {
                    tape[dp] = 0
                }
            } else if op == 91 {
                if tape[dp] == 0 {
                    pc = jmp[pc]
                }
            } else if op == 93 {
                if tape[dp] != 0 {
                    pc = jmp[pc]
                }
            }
            pc += 1
        }
        seed += 1
    }
    println(out_cnt)
    println((s2 << 8) | s1)
    << 0
}
