@main

fn isqrt64(n int) int {
    if n <= 0 {
        << 0
    }
    $x := n
    $y := (x + 1) >> 1
    while y < x {
        x = y
        y = (x + n / x) >> 1
    }
    << x
}

fn sdiv(num int, den int) int {
    if num >= 0 {
        << num / den
    }
    << -((-num) / den)
}

fn main() int {
    mod_v := 1000000007
    n := 512
    arena := 65536
    $rng := 62626262

    $px := []int{}
    $py := []int{}
    $vx := []int{}
    $vy := []int{}
    $rad := []int{}
    $nxt_b := []int{}
    $i := 0
    while i < n {
        row := i / 32
        col := i % 32
        rng = (rng * 1103515245 + 12345) & 2147483647
        px.push(1024 + col * 2000 + (rng % 200))
        rng = (rng * 1103515245 + 12345) & 2147483647
        py.push(1024 + row * 4000 + (rng % 200))
        rng = (rng * 1103515245 + 12345) & 2147483647
        vx.push((rng % 321) - 160)
        rng = (rng * 1103515245 + 12345) & 2147483647
        vy.push((rng % 321) - 160)
        rng = (rng * 1103515245 + 12345) & 2147483647
        rad.push(384 + (rng % 257))
        nxt_b.push(-1)
        i += 1
    }

    $head := []int{}
    $c := 0
    while c < 256 {
        head.push(-1)
        c += 1
    }

    $collisions := 0
    $step := 0
    while step < 500 {
        c = 0
        while c < 256 {
            head[c] = -1
            c += 1
        }
        i = 0
        while i < n {
            $x := px[i] + vx[i]
            $y := py[i] + vy[i]
            r := rad[i]
            if x < r {
                x = r
                vx[i] = -vx[i]
            } else if x > arena - r {
                x = arena - r
                vx[i] = -vx[i]
            }
            if y < r {
                y = r
                vy[i] = -vy[i]
            } else if y > arena - r {
                y = arena - r
                vy[i] = -vy[i]
            }
            px[i] = x
            py[i] = y
            $cx := x >> 12
            $cy := y >> 12
            if cx > 15 {
                cx = 15
            }
            if cy > 15 {
                cy = 15
            }
            cell := (cy << 4) | cx
            nxt_b[i] = head[cell]
            head[cell] = i
            i += 1
        }

        i = 0
        while i < n {
            $cx := px[i] >> 12
            $cy := py[i] >> 12
            if cx > 15 {
                cx = 15
            }
            if cy > 15 {
                cy = 15
            }
            $y0 := cy - 1
            if y0 < 0 {
                y0 = 0
            }
            $y1 := cy + 1
            if y1 > 15 {
                y1 = 15
            }
            $x0 := cx - 1
            if x0 < 0 {
                x0 = 0
            }
            $x1 := cx + 1
            if x1 > 15 {
                x1 = 15
            }
            $ny := y0
            while ny <= y1 {
                $nx := x0
                while nx <= x1 {
                    $j := head[(ny << 4) | nx]
                    while j != -1 {
                        if j > i {
                            dx := px[j] - px[i]
                            dy := py[j] - py[i]
                            rsum := rad[i] + rad[j]
                            dist2 := dx * dx + dy * dy
                            if dist2 < rsum * rsum && dist2 > 0 {
                                collisions += 1
                                $dist := isqrt64(dist2)
                                if dist < 1 {
                                    dist = 1
                                }
                                half := (rsum - dist + 1) >> 1
                                sx := sdiv(dx * half, dist)
                                sy := sdiv(dy * half, dist)
                                px[i] -= sx
                                py[i] -= sy
                                px[j] += sx
                                py[j] += sy
                                vn := (vx[j] - vx[i]) * dx + (vy[j] - vy[i]) * dy
                                if vn < 0 {
                                    ix := sdiv(vn * dx, dist2)
                                    iy := sdiv(vn * dy, dist2)
                                    vx[i] += ix
                                    vy[i] += iy
                                    vx[j] -= ix
                                    vy[j] -= iy
                                }
                            }
                        }
                        j = nxt_b[j]
                    }
                    nx += 1
                }
                ny += 1
            }
            i += 1
        }
        step += 1
    }

    $ck := 0
    i = 0
    while i < n {
        v := (px[i] + 100000) * 7 + (py[i] + 100000) * 13 + (vx[i] + 100000) * 17 + (vy[i] + 100000)
        ck = (ck * 31 + (v % mod_v)) % mod_v
        i += 1
    }

    println(collisions)
    println(ck)
    << 0
}
