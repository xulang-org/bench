@main
// Osprey (MIT): benchmarks/cases/quicksort; deterministic original workload.
// https://github.com/Nimblesite/osprey ; see tests/bench/osprey/README.md.

// Osprey first-element-pivot quicksort; two partition passes and fresh vectors.
// 8 rounds x 2000 values; seed=1+131*t, rank-weighted modular checksum.
// Identical partition/concatenate/push loops in all ports; see tests/bench/osprey/README.md.

fn hash_at(seed int, i int) int {
    << (((seed + i) * 16807) % 2147483647 * 16807) % 2147483647
}

fn quicksort(xs &[]int) []int {
    if xs.len == 0 { << []int{} }
    pivot := xs[0]
    mut below := []int{}
    mut at_least := []int{}
    mut i := 1
    while i < xs.len {
        if xs[i] < pivot { below.push(xs[i]) }
        i += 1
    }
    i = 1
    while i < xs.len {
        if xs[i] >= pivot { at_least.push(xs[i]) }
        i += 1
    }
    mut sorted := quicksort(&below)
    sorted.push(pivot)
    right := quicksort(&at_least)
    i = 0
    while i < right.len { sorted.push(right[i])
        i += 1 }
    << sorted
}

fn main() int {
    mut total := 0
    mut t := 0
    while t < 8 {
        mut xs := []int{}
        mut i := 0
        while i < 2000 {
            xs.push(hash_at(1 + t * 131, i) % 100000)
            i += 1
        }
        sorted := quicksort(&xs)
        mut weight := 0
        i = 0
        while i < sorted.len {
            weight = (weight + sorted[i] * (i + 1)) % 1000000007
            i += 1
        }
        total = (total + weight) % 1000000007
        t += 1
    }
    println(total)
    << 0
}
