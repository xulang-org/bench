@main
#strings
fn main() int {
    $pool := []string{}
    $si := 0
    while si < 32 {
        n := 8 + si % 24
        $src := make_string(n)
        $j := 0
        while j < n { src[j] = 97 + (j + si) % 3
            j += 1 }
        pool.push(src)
        si += 1
    }
    $state := 1
    $total := 0
    $i := 0
    while i < 1000000 {
        state = (state * 1103515245 + 12345) & 2147483647
        idx := (state >> 16) & 31
        target := 97 + ((state >> 8) & 1)
        total += count_byte(&pool[idx], target)
        i += 1
    }
    println(total)
    << 0
}
