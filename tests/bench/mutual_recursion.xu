@main
// Osprey (MIT): benchmarks/cases/mutual; deterministic original workload.
// https://github.com/Nimblesite/osprey ; see tests/bench/osprey/README.md.

// Mutually recursive parity, i%1000 for 1 <= i < 130000.

fn even(n int) int {
    if n == 0 { << 1 }
    << odd(n - 1)
}
fn odd(n int) int {
    if n == 0 { << 0 }
    << even(n - 1)
}

fn main() int {
    mut result := 0
    mut i := 1
    while i < 130000 {
        result += even(i % 1000)
        i += 1
    }
    println(result)
    << 0
}
