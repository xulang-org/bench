@main

fn node(id int, in_ch chan int, out_ch chan int, done chan int) {
    while true {
        v := <-in_ch
        if v < 0 {
            out_ch <- -1
            <<
        }
        if v == 0 {
            done <- id
            out_ch <- -1
            <<
        }
        out_ch <- v - 1
    }
}

fn main() int {
    n := 503
    $chs := []chan int{}
    $i := 0
    while i < n {
        chs.push(chan int{cap: 1})
        i += 1
    }
    done := chan int{cap: 1}
    i = 0
    while i < n {
        nxt := (i + 1) % n
        xu node(i + 1, chs[i], chs[nxt], done)
        i += 1
    }
    chs[0] <- 100000
    winner := <-done
    println(winner)
    << 0
}
