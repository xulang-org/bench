@main
// Osprey (MIT): benchmarks/cases/textstats; deterministic original workload.
// https://github.com/Nimblesite/osprey ; see tests/bench/osprey/README.md.
#strings


fn hash_at(seed int, i int) int {
    << (((seed + i) * 16807) % 2147483647 * 16807) % 2147483647
}

fn word(k int) string {
    if k == 0 { << "the" }
    if k == 1 { << "quick" }
    if k == 2 { << "brown" }
    if k == 3 { << "fox" }
    if k == 4 { << "jumps" }
    if k == 5 { << "over" }
    if k == 6 { << "lazy" }
    << "dog"
}

fn score(w string) int {
    mut total := w.len
    if strings.contains(&w, "o") { total += 7 }
    if strings.has_prefix(&w, "t") { total += 3 }
    << total
}

fn main() int {
    mut result := 0
    mut i := 0
    while i < 200000 {
        result += score(word(hash_at(1, i) % 8))
        i += 1
    }
    println(result)
    << 0
}
