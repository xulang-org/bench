@main

fn put_uvarint(buf $&[]int, val int) {
    $v := val
    while v >= 128 {
        buf.push((v & 127) | 128)
        v = v >> 7
    }
    buf.push(v & 127)
}

fn zigzag_enc(v int) int {
    if v >= 0 {
        << v << 1
    }
    << ((-v) << 1) - 1
}

fn zigzag_dec(u int) int {
    if (u & 1) == 0 {
        << u >> 1
    }
    << -((u >> 1) + 1)
}

fn push_str_bytes(buf $&[]int, s string) {
    $i := 0
    while i < s.len {
        buf.push(s[i] & 255)
        i += 1
    }
}

fn main() int {
    mod_v := 1000000007
    $symbols := []string{}
    symbols.push("BTC-USD")
    symbols.push("ETH-EUR")
    symbols.push("SOL-JPY")
    symbols.push("XU-USD")
    symbols.push("NVDA")
    symbols.push("AAPL")
    symbols.push("GOOG")
    symbols.push("MSFT")
    $tags := []string{}
    tags.push("fast")
    tags.push("batch")
    tags.push("edge")
    tags.push("core")
    tags.push("prod")
    tags.push("canary")
    tags.push("blue")
    tags.push("green")

    $buf := []int{}
    $meta := []int{}
    $packed := []int{}
    $msg := []int{}
    $qs := []int{}
    $qi_init := 0
    while qi_init < 8 {
        qs.push(0)
        qi_init += 1
    }

    $rng := 314159265
    $total_wire := 0
    $ck := 0
    $batch := 0
    while batch < 400 {
        buf = []int{}
        $i := 0
        while i < 500 {
            rng = (rng * 1103515245 + 12345) & 2147483647
            order_id := (batch * 500 + i + 1) * 131 + (rng & 1023)
            rng = (rng * 1103515245 + 12345) & 2147483647
            price_delta := (rng % 200001) - 100000
            rng = (rng * 1103515245 + 12345) & 2147483647
            sym := symbols[rng & 7]
            rng = (rng * 1103515245 + 12345) & 2147483647
            qcnt := 4 + (rng & 3)
            $qi := 0
            while qi < qcnt {
                rng = (rng * 1103515245 + 12345) & 2147483647
                qs[qi] = 1 + (rng % 5000)
                qi += 1
            }
            rng = (rng * 1103515245 + 12345) & 2147483647
            reg_id := 1 + (rng & 31)
            rng = (rng * 1103515245 + 12345) & 2147483647
            lat_us := (rng % 10001) - 5000
            rng = (rng * 1103515245 + 12345) & 2147483647
            tag := tags[rng & 7]

            meta = []int{}
            put_uvarint($&meta, (1 << 3) | 0)
            put_uvarint($&meta, reg_id)
            put_uvarint($&meta, (2 << 3) | 0)
            put_uvarint($&meta, zigzag_enc(lat_us))
            put_uvarint($&meta, (3 << 3) | 2)
            put_uvarint($&meta, tag.len)
            push_str_bytes($&meta, tag)

            packed = []int{}
            qi = 0
            while qi < qcnt {
                put_uvarint($&packed, qs[qi])
                qi += 1
            }

            msg = []int{}
            put_uvarint($&msg, (1 << 3) | 0)
            put_uvarint($&msg, order_id)
            put_uvarint($&msg, (2 << 3) | 0)
            put_uvarint($&msg, zigzag_enc(price_delta))
            put_uvarint($&msg, (3 << 3) | 2)
            put_uvarint($&msg, sym.len)
            push_str_bytes($&msg, sym)
            put_uvarint($&msg, (4 << 3) | 2)
            put_uvarint($&msg, packed.len)
            $pk := 0
            while pk < packed.len {
                msg.push(packed[pk])
                pk += 1
            }
            put_uvarint($&msg, (5 << 3) | 2)
            put_uvarint($&msg, meta.len)
            $mk := 0
            while mk < meta.len {
                msg.push(meta[mk])
                mk += 1
            }

            put_uvarint($&buf, msg.len)
            $mi := 0
            while mi < msg.len {
                buf.push(msg[mi])
                mi += 1
            }
            i += 1
        }

        total_wire += buf.len
        $pos := 0
        blen := buf.len
        while pos < blen {
            $mlen := 0
            $sh := 0
            while true {
                b := buf[pos]
                pos += 1
                mlen = mlen | ((b & 127) << sh)
                if (b & 128) == 0 {
                    <-
                }
                sh += 7
            }
            end := pos + mlen
            $oid := 0
            $pdelta := 0
            $sym_sum := 0
            $q_sum := 0
            $reg := 0
            $lat := 0
            $tlen := 0
            while pos < end {
                $tag_w := 0
                sh = 0
                while true {
                    b := buf[pos]
                    pos += 1
                    tag_w = tag_w | ((b & 127) << sh)
                    if (b & 128) == 0 {
                        <-
                    }
                    sh += 7
                }
                fnum := tag_w >> 3
                wtype := tag_w & 7
                if wtype == 0 {
                    $val := 0
                    sh = 0
                    while true {
                        b := buf[pos]
                        pos += 1
                        val = val | ((b & 127) << sh)
                        if (b & 128) == 0 {
                            <-
                        }
                        sh += 7
                    }
                    if fnum == 1 {
                        oid = val
                    } else if fnum == 2 {
                        pdelta = zigzag_dec(val)
                    }
                } else if wtype == 2 {
                    $ln := 0
                    sh = 0
                    while true {
                        b := buf[pos]
                        pos += 1
                        ln = ln | ((b & 127) << sh)
                        if (b & 128) == 0 {
                            <-
                        }
                        sh += 7
                    }
                    sub_end := pos + ln
                    if fnum == 3 {
                        while pos < sub_end {
                            sym_sum += buf[pos]
                            pos += 1
                        }
                    } else if fnum == 4 {
                        while pos < sub_end {
                            $qv := 0
                            sh = 0
                            while true {
                                b := buf[pos]
                                pos += 1
                                qv = qv | ((b & 127) << sh)
                                if (b & 128) == 0 {
                                    <-
                                }
                                sh += 7
                            }
                            q_sum += qv
                        }
                    } else if fnum == 5 {
                        while pos < sub_end {
                            $mtag := 0
                            sh = 0
                            while true {
                                b := buf[pos]
                                pos += 1
                                mtag = mtag | ((b & 127) << sh)
                                if (b & 128) == 0 {
                                    <-
                                }
                                sh += 7
                            }
                            mf := mtag >> 3
                            mw := mtag & 7
                            if mw == 0 {
                                $mv := 0
                                sh = 0
                                while true {
                                    b := buf[pos]
                                    pos += 1
                                    mv = mv | ((b & 127) << sh)
                                    if (b & 128) == 0 {
                                        <-
                                    }
                                    sh += 7
                                }
                                if mf == 1 {
                                    reg = mv
                                } else if mf == 2 {
                                    lat = zigzag_dec(mv)
                                }
                            } else if mw == 2 {
                                $sln := 0
                                sh = 0
                                while true {
                                    b := buf[pos]
                                    pos += 1
                                    sln = sln | ((b & 127) << sh)
                                    if (b & 128) == 0 {
                                        <-
                                    }
                                    sh += 7
                                }
                                if mf == 3 {
                                    tlen = sln
                                }
                                pos += sln
                            }
                        }
                    } else {
                        pos = sub_end
                    }
                }
            }
            $row := (oid + pdelta + sym_sum + q_sum + reg * 13 + lat + tlen * 7) % mod_v
            if row < 0 {
                row += mod_v
            }
            ck = (ck * 31 + row) % mod_v
        }
        batch += 1
    }
    println(total_wire)
    println(ck)
    << 0
}
