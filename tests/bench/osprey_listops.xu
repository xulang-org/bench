@main
// Osprey (MIT): benchmarks/cases/listops; deterministic original workload.
// https://github.com/Nimblesite/osprey ; see tests/bench/osprey/README.md.

fn hash_at(seed int, i int) int {
    << (((seed + i) * 16807) % 2147483647 * 16807) % 2147483647
}

fn sum_list(xs &[]int, i int) int {
    if i == xs.len { << 0 }
    << xs[i] + sum_list(xs, i + 1)
}

fn below_list(xs &[]int, i int) int {
    if i == xs.len { << 0 }
    mut add := 0
    if xs[i] < 500 { add = 1 }
    << add + below_list(xs, i + 1)
}

fn main() int {
    mut total := 0
    mut t := 0
    while t < 8 {
        mut xs := []int{}
        mut i := 0
        while i < 4000 {
            xs.push(hash_at(1 + t * 131, i) % 1000)
            i += 1
        }
        total = (total + sum_list(&xs, 0) + below_list(&xs, 0)) % 1000000007
        t += 1
    }
    println(total)
    << 0
}
