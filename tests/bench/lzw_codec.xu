@main

#compress/lzw as lzw
#strings

fn main() int {
    base := "TOBEORNOTTOBEORTOBEORNOT#"
    payload := strings.repeat(&base, 16)
    mut total := 0
    mut i := 0
    while i < 2500 {
        enc := lzw.encode(&payload, lzw.lsb, 8) or (err) { << 1 }
        enc_len := enc.len
        dec := lzw.decode(&enc, lzw.lsb, 8) or (err) { << 1 }
        total += enc_len + dec.len
        if i == 0 {
            total += dec[0] + dec[dec.len - 1]
        }
        i += 1
    }
    println(total)
    << 0
}
