@main

struct BloomFilter {
    pub bits []int
    pub mask int
}

fn new_bloom(num_bits int) BloomFilter {
    $b := []int{}
    words := num_bits / 64
    $i := 0
    while i < words {
        b.push(0)
        i += 1
    }
    << BloomFilter{bits: b, mask: num_bits - 1}
}

fn (bf $&BloomFilter) add(val int) {
    h1 := (val * 1103515245 + 12345) & 2147483647
    h2 := (val * 1664525 + 1013904223) & 2147483647
    mask := bf.mask
    b0 := h1 & mask
    b1 := (h1 + h2) & mask
    b2 := (b1 + h2) & mask
    b3 := (b2 + h2) & mask
    bf.bits[b0 >> 6] = bf.bits[b0 >> 6] | (1 << (b0 & 63))
    bf.bits[b1 >> 6] = bf.bits[b1 >> 6] | (1 << (b1 & 63))
    bf.bits[b2 >> 6] = bf.bits[b2 >> 6] | (1 << (b2 & 63))
    bf.bits[b3 >> 6] = bf.bits[b3 >> 6] | (1 << (b3 & 63))
}

fn (bf &BloomFilter) contains(val int) bool {
    mask := bf.mask
    h1 := (val * 1103515245 + 12345) & 2147483647
    b0 := h1 & mask
    if (bf.bits[b0 >> 6] & (1 << (b0 & 63))) == 0 {
        << false
    }
    h2 := (val * 1664525 + 1013904223) & 2147483647
    b1 := (h1 + h2) & mask
    if (bf.bits[b1 >> 6] & (1 << (b1 & 63))) == 0 {
        << false
    }
    b2 := (b1 + h2) & mask
    if (bf.bits[b2 >> 6] & (1 << (b2 & 63))) == 0 {
        << false
    }
    b3 := (b2 + h2) & mask
    if (bf.bits[b3 >> 6] & (1 << (b3 & 63))) == 0 {
        << false
    }
    << true
}

fn main() int {
    $bf := new_bloom(1048576)
    $seed := 123456789

    // Insert 200,000 elements
    $i := 0
    while i < 200000 {
        seed = (seed * 1664525 + 1013904223) % 2147483647
        bf.add(seed)
        i += 1
    }

    // Query 2,000,000 elements
    $checksum := 0
    i = 0
    while i < 2000000 {
        seed = (seed * 1664525 + 1013904223) % 2147483647
        if bf.contains(seed) {
            checksum = (checksum * 31 + seed) % 1000000007
        }
        i += 1
    }

    println(checksum)
    << 0
}
