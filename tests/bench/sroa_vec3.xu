@main

// AoS f64 fields: 256 Vec3, 40000 reductions.
// Probes SROA / FieldRMW / mixed struct+scalar RA. Not nbody (no sqrt).
struct Vec3 {
    x f64
    y f64
    z f64
}

fn fill() []Vec3 {
    $v := []Vec3{}
    $i := 0
    while i < 256 {
        v.push(Vec3{x: f64(i & 7), y: f64((i * 3) & 7), z: f64((i * 5) & 7)})
        i += 1
    }
    << v
}

fn main() int {
    v := fill()
    $acc := 0.0
    $t := 0
    while t < 40000 {
        $i := 0
        while i < 256 {
            acc += v[i].x * v[i].x + v[i].y * v[i].y + v[i].z * v[i].z
            i += 1
        }
        t += 1
    }
    println(int(acc))
    << 0
}
