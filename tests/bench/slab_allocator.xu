@main

struct SlabArena {
    pub mem []int
    pub page_cls []int
    pub page_used []int
    pub page_head []int
    pub page_prev []int
    pub page_next []int
    pub page_in_list []int
    pub cls_head []int
    pub free_stack []int
    pub free_top int
    pub class_sz []int
    pub page_allocs int
    pub page_reclaims int
}

fn new_slab() SlabArena {
    n_pages := 256
    $s := SlabArena{
        mem: []int{},
        page_cls: []int{},
        page_used: []int{},
        page_head: []int{},
        page_prev: []int{},
        page_next: []int{},
        page_in_list: []int{},
        cls_head: []int{},
        free_stack: []int{},
        free_top: n_pages,
        class_sz: []int{},
        page_allocs: 0,
        page_reclaims: 0
    }
    $i := 0
    while i < n_pages * 256 {
        s.mem.push(0)
        i += 1
    }
    i = 0
    while i < n_pages {
        s.page_cls.push(-1)
        s.page_used.push(0)
        s.page_head.push(-1)
        s.page_prev.push(-1)
        s.page_next.push(-1)
        s.page_in_list.push(0)
        s.free_stack.push(n_pages - 1 - i)
        i += 1
    }
    i = 0
    while i < 6 {
        s.cls_head.push(-1)
        i += 1
    }
    s.class_sz.push(2)
    s.class_sz.push(4)
    s.class_sz.push(8)
    s.class_sz.push(16)
    s.class_sz.push(32)
    s.class_sz.push(64)
    << s
}

fn list_push(s $&SlabArena, cls int, pg int) {
    h := s.cls_head[cls]
    s.page_prev[pg] = -1
    s.page_next[pg] = h
    if h != -1 {
        s.page_prev[h] = pg
    }
    s.cls_head[cls] = pg
    s.page_in_list[pg] = 1
}

fn list_remove(s $&SlabArena, cls int, pg int) {
    pr := s.page_prev[pg]
    nx := s.page_next[pg]
    if pr != -1 {
        s.page_next[pr] = nx
    } else {
        s.cls_head[cls] = nx
    }
    if nx != -1 {
        s.page_prev[nx] = pr
    }
    s.page_prev[pg] = -1
    s.page_next[pg] = -1
    s.page_in_list[pg] = 0
}

fn slab_alloc(s $&SlabArena, cls int) int {
    $pg := s.cls_head[cls]
    if pg == -1 {
        if s.free_top == 0 {
            << -1
        }
        s.free_top -= 1
        pg = s.free_stack[s.free_top]
        s.page_allocs += 1
        s.page_cls[pg] = cls
        s.page_used[pg] = 0
        sz := s.class_sz[cls]
        base := pg << 8
        cnt := 256 / sz
        $j := 0
        while j < cnt - 1 {
            s.mem[base + j * sz] = base + (j + 1) * sz
            j += 1
        }
        s.mem[base + (cnt - 1) * sz] = -1
        s.page_head[pg] = base
        list_push(s, cls, pg)
    }
    ptr := s.page_head[pg]
    nxt_ptr := s.mem[ptr]
    s.page_head[pg] = nxt_ptr
    s.page_used[pg] += 1
    if nxt_ptr == -1 {
        list_remove(s, cls, pg)
    }
    << ptr
}

fn slab_free(s $&SlabArena, ptr int) {
    pg := ptr >> 8
    cls := s.page_cls[pg]
    $was_full := 0
    if s.page_head[pg] == -1 {
        was_full = 1
    }
    s.mem[ptr] = s.page_head[pg]
    s.page_head[pg] = ptr
    s.page_used[pg] -= 1
    if s.page_used[pg] == 0 {
        if s.page_in_list[pg] == 1 {
            list_remove(s, cls, pg)
        }
        s.page_cls[pg] = -1
        s.page_head[pg] = -1
        s.free_stack[s.free_top] = pg
        s.free_top += 1
        s.page_reclaims += 1
    } else if was_full == 1 {
        list_push(s, cls, pg)
    }
}

fn main() int {
    mod_v := 1000000007
    live := 1024
    $s := new_slab()
    $rng := 31415926

    $live_ptr := []int{}
    $live_cls := []int{}
    $i := 0
    while i < live {
        live_ptr.push(-1)
        live_cls.push(0)
        i += 1
    }

    $alloc_ok := 0
    $ck := 0
    $op_i := 0
    while op_i < 600000 {
        rng = (rng * 1103515245 + 12345) & 2147483647
        slot := rng & 1023
        if (op_i & 4095) == 4095 {
            $k := 0
            while k < live {
                p := live_ptr[k]
                if p != -1 {
                    sz := s.class_sz[live_cls[k]]
                    ck = (ck * 31 + s.mem[p] + s.mem[p + sz - 1]) % mod_v
                    slab_free($&s, p)
                    live_ptr[k] = -1
                }
                k += 3
            }
        }
        if live_ptr[slot] != -1 {
            p := live_ptr[slot]
            sz := s.class_sz[live_cls[slot]]
            ck = (ck * 31 + s.mem[p] + s.mem[p + sz - 1]) % mod_v
            slab_free($&s, p)
            live_ptr[slot] = -1
        } else {
            rng = (rng * 1103515245 + 12345) & 2147483647
            r := rng % 100
            $cls := 5
            if r < 35 {
                cls = 0
            } else if r < 60 {
                cls = 1
            } else if r < 78 {
                cls = 2
            } else if r < 90 {
                cls = 3
            } else if r < 97 {
                cls = 4
            }
            p := slab_alloc($&s, cls)
            if p >= 0 {
                sz := s.class_sz[cls]
                tag := (op_i * 13 + cls * 7 + 1) % mod_v
                s.mem[p] = tag
                s.mem[p + sz - 1] = (tag ^ (p * 3)) % mod_v
                live_ptr[slot] = p
                live_cls[slot] = cls
                alloc_ok += 1
            }
        }
        op_i += 1
    }

    $k := 0
    while k < live {
        p := live_ptr[k]
        if p != -1 {
            sz := s.class_sz[live_cls[k]]
            ck = (ck * 31 + s.mem[p] + s.mem[p + sz - 1]) % mod_v
            slab_free($&s, p)
            live_ptr[k] = -1
        }
        k += 1
    }
    ck = (ck * 37 + s.page_allocs * 17 + s.page_reclaims) % mod_v
    println(alloc_ok)
    println(ck)
    << 0
}
