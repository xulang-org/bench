@main

struct TokenResult {
    pub count int
    pub chk int
}

fn tokenize(src string) TokenResult {
    n := src.len
    $pos := 0
    $count := 0
    $chk := 0
    while pos < n {
        c := src[pos] & 255
        if c == 32 || c == 9 || c == 10 || c == 13 {
            pos += 1
            ->
        }
        $t_type := 0
        $t_len := 0
        if c == 123 {
            t_type = 1
            t_len = 1
            pos += 1
        } else if c == 125 {
            t_type = 2
            t_len = 1
            pos += 1
        } else if c == 91 {
            t_type = 3
            t_len = 1
            pos += 1
        } else if c == 93 {
            t_type = 4
            t_len = 1
            pos += 1
        } else if c == 58 {
            t_type = 5
            t_len = 1
            pos += 1
        } else if c == 44 {
            t_type = 6
            t_len = 1
            pos += 1
        } else if c == 34 {
            t_type = 7
            start := pos
            pos += 1
            while pos < n {
                ch := src[pos] & 255
                if ch == 92 {
                    pos += 2
                } else if ch == 34 {
                    pos += 1
                    <-
                } else {
                    pos += 1
                }
            }
            t_len = pos - start
        } else if c == 45 || (c >= 48 && c <= 57) {
            t_type = 8
            start := pos
            if c == 45 {
                pos += 1
            }
            while pos < n && ((src[pos] & 255) >= 48 && (src[pos] & 255) <= 57) {
                pos += 1
            }
            if pos < n && (src[pos] & 255) == 46 {
                pos += 1
                while pos < n && ((src[pos] & 255) >= 48 && (src[pos] & 255) <= 57) {
                    pos += 1
                }
            }
            t_len = pos - start
        } else if c == 116 {
            t_type = 9
            t_len = 4
            pos += 4
        } else if c == 102 {
            t_type = 10
            t_len = 5
            pos += 5
        } else if c == 110 {
            t_type = 11
            t_len = 4
            pos += 4
        } else {
            pos += 1
            ->
        }
        count += 1
        chk = (chk * 37 + t_type * 101 + t_len) % 1000000007
    }
    << TokenResult{count: count, chk: chk}
}

fn main() int {
    base := "{\"project\":\"Xu\",\"version\":1.0,\"active\":true,\"count\":100,\"flag\":false,\"note\":null,\"data\":[1,2,-3,40]}"
    $full := ""
    $k := 0
    while k < 10 {
        full = full + base
        k += 1
    }
    $total := 0
    $r := 0
    while r < 1000 {
        res := tokenize(full)
        total = (total * 31 + res.chk) % 1000000007
        r += 1
    }
    println(total)
    << 0
}
