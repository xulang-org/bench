@main

fn lcg(seed int) int {
    << (seed * 1103515245 + 12345) & 2147483647
}

fn main() int {
    n := 200000
    q := 200000
    $st := []int{}
    $en := []int{}
    $max_en := []int{}

    $seed := 123456789
    $cur_st := 0
    $i := 0
    while i < n {
        seed = lcg(seed)
        cur_st += seed % 100
        seed = lcg(seed)
        ln := 1 + (seed % 5000)
        st.push(cur_st)
        en.push(cur_st + ln)
        max_en.push(0)
        i += 1
    }
    max_coord := cur_st + 1

    $qst := []int{}
    $qen := []int{}
    i = 0
    while i < q {
        seed = lcg(seed)
        qs := seed % max_coord
        seed = lcg(seed)
        ln := 1 + (seed % 5000)
        qst.push(qs)
        qen.push(qs + ln)
        i += 1
    }

    i = 0
    while i < n {
        max_en[i] = en[i]
        i += 2
    }
    $k := 1
    while (1 << k) <= n {
        x := 1 << (k - 1)
        i0 := (x << 1) - 1
        step := x << 2
        i = i0
        while i < n {
            el := max_en[i - x]
            $er := 0
            if i + x < n {
                er = max_en[i + x]
            } else {
                er = en[i]
                $lim := i + (x << 1)
                if lim > n {
                    lim = n
                }
                $j := i + 1
                while j < lim {
                    if en[j] > er {
                        er = en[j]
                    }
                    j += 1
                }
            }
            $e := en[i]
            if el > e {
                e = el
            }
            if er > e {
                e = er
            }
            max_en[i] = e
            i += step
        }
        k += 1
    }
    max_k := k - 1

    $sk := []int{}
    $sx := []int{}
    $sw := []int{}
    i = 0
    while i < 64 {
        sk.push(0)
        sx.push(0)
        sw.push(0)
        i += 1
    }

    $hits := 0
    $cov_sum := 0
    $qi := 0
    root_x := (1 << max_k) - 1
    while qi < q {
        qs := qst[qi]
        qe := qen[qi]
        $sp := 0
        sk[0] = max_k
        sx[0] = root_x
        sw[0] = 0
        sp = 1
        while sp > 0 {
            sp -= 1
            kk := sk[sp]
            x := sx[sp]
            w := sw[sp]
            if kk <= 3 {
                i0 := (x >> kk) << kk
                $i1 := i0 + (1 << (kk + 1)) - 1
                if i1 >= n {
                    i1 = n
                }
                $ii := i0
                while ii < i1 && st[ii] < qe {
                    if qs < en[ii] {
                        hits += 1
                        $os := st[ii]
                        if qs > os {
                            os = qs
                        }
                        $oe := en[ii]
                        if qe < oe {
                            oe = qe
                        }
                        cov_sum += oe - os
                    }
                    ii += 1
                }
            } else if w == 0 {
                y := x - (1 << (kk - 1))
                sk[sp] = kk
                sx[sp] = x
                sw[sp] = 1
                sp += 1
                if y >= n || max_en[y] > qs {
                    sk[sp] = kk - 1
                    sx[sp] = y
                    sw[sp] = 0
                    sp += 1
                }
            } else if x < n && st[x] < qe {
                if qs < en[x] {
                    hits += 1
                    $os := st[x]
                    if qs > os {
                        os = qs
                    }
                    $oe := en[x]
                    if qe < oe {
                        oe = qe
                    }
                    cov_sum += oe - os
                }
                sk[sp] = kk - 1
                sx[sp] = x + (1 << (kk - 1))
                sw[sp] = 0
                sp += 1
            }
        }
        qi += 1
    }
    println(hits)
    println(cov_sum)
    << 0
}
