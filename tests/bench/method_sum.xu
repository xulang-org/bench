@main

// Struct + mutating method: 8e6 calls. Language method/ABI capability.
// checksum: 28000000
struct Acc {
    n int
}

fn (a $&Acc) add(x int) {
    a.n += x
}

fn main() int {
    $a := Acc{n: 0}
    $i := 0
    while i < 8000000 {
        a.add(i & 7)
        i += 1
    }
    println(a.n)
    << 0
}
