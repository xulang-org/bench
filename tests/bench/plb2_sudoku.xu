@main

struct SudokuAux {
    pub r_tbl []int
    pub c_tbl []int
}

fn new_sudoku_aux() SudokuAux {
    $r_tbl := []int{}
    $c_tbl := []int{}
    $nr := []int{}
    $i := 0
    while i < 2916 {
        r_tbl.push(0)
        c_tbl.push(0)
        i += 1
    }
    i = 0
    while i < 324 {
        nr.push(0)
        i += 1
    }
    $row := 0
    while row < 9 {
        $col := 0
        while col < 9 {
            $k := 0
            while k < 9 {
                r := (row * 9 + col) * 9 + k
                c0 := row * 9 + col
                c1 := 81 + row * 9 + k
                c2 := 162 + col * 9 + k
                c3 := 243 + ((row / 3) * 3 + (col / 3)) * 9 + k
                base := r * 4
                c_tbl[base] = c0
                c_tbl[base + 1] = c1
                c_tbl[base + 2] = c2
                c_tbl[base + 3] = c3
                r_tbl[c0 * 9 + nr[c0]] = r
                nr[c0] += 1
                r_tbl[c1 * 9 + nr[c1]] = r
                nr[c1] += 1
                r_tbl[c2 * 9 + nr[c2]] = r
                nr[c2] += 1
                r_tbl[c3 * 9 + nr[c3]] = r
                nr[c3] += 1
                k += 1
            }
            col += 1
        }
        row += 1
    }
    << SudokuAux{r_tbl: r_tbl, c_tbl: c_tbl}
}

fn sd_update(aux &SudokuAux, sr $&[]int, sc $&[]int, r int, v int) int {
    $min_sc := 10
    $min_c := 0
    r_base := r * 4
    $c2 := 0
    while c2 < 4 {
        c := aux.c_tbl[r_base + c2]
        sc[c] += v * 128
        c2 += 1
    }
    c2 = 0
    while c2 < 4 {
        c := aux.c_tbl[r_base + c2]
        rc_base := c * 9
        if v > 0 {
            $j := 0
            while j < 9 {
                rr := aux.r_tbl[rc_base + j]
                sr[rr] += 1
                if sr[rr] == 1 {
                    rr_base := rr * 4
                    $k := 0
                    while k < 4 {
                        cc := aux.c_tbl[rr_base + k]
                        sc[cc] -= 1
                        if sc[cc] < min_sc {
                            min_sc = sc[cc]
                            min_c = cc
                        }
                        k += 1
                    }
                }
                j += 1
            }
        } else {
            $j := 0
            while j < 9 {
                rr := aux.r_tbl[rc_base + j]
                sr[rr] -= 1
                if sr[rr] == 0 {
                    rr_base := rr * 4
                    $k := 0
                    while k < 4 {
                        cc := aux.c_tbl[rr_base + k]
                        sc[cc] += 1
                        k += 1
                    }
                }
                j += 1
            }
        }
        c2 += 1
    }
    << (min_sc << 16) | min_c
}

fn sd_solve(aux &SudokuAux, puzzle string) int {
    $sr := []int{}
    $sc := []int{}
    $cr := []int{}
    $cc := []int{}
    $out := []int{}
    $i := 0
    while i < 729 {
        sr.push(0)
        i += 1
    }
    i = 0
    while i < 324 {
        sc.push(9)
        i += 1
    }
    i = 0
    while i < 81 {
        cr.push(-1)
        cc.push(-1)
        out.push(0)
        i += 1
    }

    $hints := 0
    i = 0
    while i < 81 {
        ch := puzzle[i] & 255
        if ch >= 49 && ch <= 57 {
            a := ch - 49
            r := i * 9 + a
            sd_update(aux, $&sr, $&sc, r, 1)
            out[i] = a + 1
            hints += 1
        }
        i += 1
    }

    $depth := 0
    $dir := 1
    limit := 81 - hints
    while depth >= 0 && depth < limit {
        if dir == 1 {
            $m := 10
            $min_c := 0
            $c := 0
            while c < 324 {
                if sc[c] < m {
                    m = sc[c]
                    min_c = c
                    if m < 2 {
                        <-
                    }
                }
                c += 1
            }
            if m == 0 || m == 10 {
                if m == 10 {
                    $c2 := 0
                    while c2 < 324 {
                        if sc[c2] < 128 {
                            m = 0
                            <-
                        }
                        c2 += 1
                    }
                    if m == 10 {
                        <-
                    }
                }
                if m == 0 {
                    cr[depth] = -1
                    depth -= 1
                    dir = -1
                    ->
                }
            }
            cc[depth] = min_c
            cr[depth] = -1
        }
        c := cc[depth]
        if dir == -1 && cr[depth] >= 0 {
            sd_update(aux, $&sr, $&sc, aux.r_tbl[c * 9 + cr[depth]], -1)
        }
        $j := cr[depth] + 1
        rc_base := c * 9
        while j < 9 {
            if sr[aux.r_tbl[rc_base + j]] == 0 {
                <-
            }
            j += 1
        }
        if j < 9 {
            cr[depth] = j
            r := aux.r_tbl[rc_base + j]
            ret := sd_update(aux, $&sr, $&sc, r, 1)
            if (ret >> 16) == 0 {
                sd_update(aux, $&sr, $&sc, r, -1)
                dir = 0
            } else {
                depth += 1
                dir = 1
            }
        } else {
            cr[depth] = -1
            depth -= 1
            dir = -1
        }
    }

    $j := 0
    while j < depth {
        c := cc[j]
        r := aux.r_tbl[c * 9 + cr[j]]
        out[r / 9] = (r % 9) + 1
        j += 1
    }

    $chk := 0
    i = 0
    while i < 81 {
        chk = (chk * 31 + out[i]) % 1000000007
        i += 1
    }
    << chk
}

fn main() int {
    aux := new_sudoku_aux()
    $puzzles := []string{}
    puzzles.push("8..........36......7..9.2...5...7.......457.....1...3...1....68..85...1..9....4..")
    puzzles.push("..3.2.6..9..3.5..1..18.64....81.29..7.......8..67.82....26.95..8..2.3..9..5.1.3..")
    puzzles.push("4.....8.5.3..........7......2.....6.....8.4......1.......6.3.7.5..2.....1.4......")
    puzzles.push("52...6.........7.13...........4..8..6......5...........418.........3..2...87.....")
    puzzles.push("6.....8.3.4.7.................5.4.7.3..2.....1.6.......2.....5.....8.6......1....")
    puzzles.push("48.3............71.2.......7.5....6....2..8.............1.76...3.....4......5....")
    puzzles.push("....14....3....2...7..........9...3.6.1.............8.2.....1.4....5.6.....7.8...")
    puzzles.push("......52..8.4......3...9...5.1...6..2..7........3.....6...1..........7.4.......3.")
    puzzles.push("6.2.5.........3.4..........43...8....1....2........7..5..27...........81...6.....")
    puzzles.push("1....7.9..3..2...8..96..5....53..9...1..8...26....4...3......1..4......7..7...3..")

    // Precompute pow31 = 31^81 mod 1000000007 to combine per-puzzle checksums identically.
    $pow31 := 1
    $k := 0
    while k < 81 {
        pow31 = (pow31 * 31) % 1000000007
        k += 1
    }

    $total := 0
    $round := 0
    while round < 20 {
        $p_idx := 0
        while p_idx < 10 {
            c := sd_solve(&aux, puzzles[p_idx])
            total = (total * pow31 + c) % 1000000007
            p_idx += 1
        }
        round += 1
    }
    println(total)
    << 0
}
