@main

// Carried integer dependence: 4096-wide prefix add, 20000 rounds.
// Probes skip-store / load-after-store vs Clang's scalar chain.
fn fill() []int {
    $a := []int{}
    $i := 0
    while i < 4096 {
        a.push(i & 1023)
        i += 1
    }
    << a
}

fn main() int {
    $a := fill()
    n := a.len
    $t := 0
    while t < 20000 {
        $prev := a[0] & 1023
        $i := 1
        while i < n {
            v := a[i] + prev
            a[i] = v
            prev = v & 1023
            i += 1
        }
        t += 1
    }
    println(a[n - 1])
    << 0
}
