@main

// Scheduler + channel throughput: 500k messages over a buffered chan.
fn worker(ch chan int, n int) {
    mut i := 0
    while i < n {
        ch <- i
        i += 1
    }
}

fn main() int {
    ch := chan int{cap: 64}
    xu worker(ch, 500000)
    mut s := 0
    mut i := 0
    while i < 500000 {
        s += <-ch
        i += 1
    }
    println(s)
    << 0
}
