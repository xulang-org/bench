@main

fn main() int {
    mod_v := 1000000007
    max_d := 120
    stride := 241
    off := 120

    $v := []int{}
    $i := 0
    while i < stride {
        v.push(0)
        i += 1
    }
    $trace := []int{}
    i = 0
    while i < (max_d + 1) * stride {
        trace.push(0)
        i += 1
    }
    $a := []int{}
    i = 0
    while i < 200 {
        a.push(0)
        i += 1
    }
    $b := []int{}
    i = 0
    while i < 300 {
        b.push(0)
        i += 1
    }
    $op_type := []int{}
    $op_val := []int{}
    i = 0
    while i < 600 {
        op_type.push(0)
        op_val.push(0)
        i += 1
    }

    $rng := 20260501
    $total_edits := 0
    $ck := 0
    $pair := 0
    while pair < 1200 {
        n := 200
        i = 0
        while i < n {
            rng = (rng * 1103515245 + 12345) & 2147483647
            val := rng & 63
            a[i] = val
            b[i] = val
            i += 1
        }
        $m := n
        rng = (rng * 1103515245 + 12345) & 2147483647
        nmut := 18 + (rng % 11)
        $mi := 0
        while mi < nmut {
            rng = (rng * 1103515245 + 12345) & 2147483647
            kind := rng % 3
            if kind == 0 && m > 120 {
                rng = (rng * 1103515245 + 12345) & 2147483647
                pos := rng % m
                $p := pos
                while p + 1 < m {
                    b[p] = b[p + 1]
                    p += 1
                }
                m -= 1
            } else if kind == 1 && m < 260 {
                rng = (rng * 1103515245 + 12345) & 2147483647
                pos := rng % (m + 1)
                rng = (rng * 1103515245 + 12345) & 2147483647
                nv := rng & 63
                $p := m
                while p > pos {
                    b[p] = b[p - 1]
                    p -= 1
                }
                b[pos] = nv
                m += 1
            } else {
                rng = (rng * 1103515245 + 12345) & 2147483647
                pos := rng % m
                rng = (rng * 1103515245 + 12345) & 2147483647
                b[pos] = rng & 63
            }
            mi += 1
        }

        v[off + 1] = 0
        $found_d := -1
        $d := 0
        while d <= max_d {
            tbase := d * stride
            $k := -d
            while k <= d {
                $x := 0
                if k == -d || (k != d && v[off + k - 1] < v[off + k + 1]) {
                    x = v[off + k + 1]
                } else {
                    x = v[off + k - 1] + 1
                }
                $y := x - k
                while x < n && y < m && a[x] == b[y] {
                    x += 1
                    y += 1
                }
                v[off + k] = x
                trace[tbase + off + k] = x
                if x >= n && y >= m {
                    found_d = d
                    <-
                }
                k += 2
            }
            if found_d >= 0 {
                <-
            }
            d += 1
        }

        $x := n
        $y := m
        $oc := 0
        $bd := found_d
        while bd > 0 {
            pbase := (bd - 1) * stride
            k := x - y
            $prev_k := 0
            if k == -bd || (k != bd && trace[pbase + off + k - 1] < trace[pbase + off + k + 1]) {
                prev_k = k + 1
            } else {
                prev_k = k - 1
            }
            prev_x := trace[pbase + off + prev_k]
            prev_y := prev_x - prev_k
            while x > prev_x && y > prev_y {
                op_type[oc] = 0
                op_val[oc] = a[x - 1]
                oc += 1
                x -= 1
                y -= 1
            }
            if x == prev_x {
                op_type[oc] = 1
                op_val[oc] = b[y - 1]
                oc += 1
                y -= 1
            } else {
                op_type[oc] = 2
                op_val[oc] = a[x - 1]
                oc += 1
                x -= 1
            }
            bd -= 1
        }
        while x > 0 && y > 0 {
            op_type[oc] = 0
            op_val[oc] = a[x - 1]
            oc += 1
            x -= 1
            y -= 1
        }

        total_edits += found_d
        $sh := found_d
        $j := 0
        while j < oc {
            sh = (sh * 131 + op_type[j] * 67 + op_val[j]) % mod_v
            j += 1
        }
        ck = (ck * 31 + sh) % mod_v
        pair += 1
    }

    println(total_edits)
    println(ck)
    << 0
}
