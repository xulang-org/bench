@main

// CRC-32 (IEEE 802.3) byte stream throughput.
fn main() int {
    n := 100000
    $data := []int{}
    $seed := 123456789
    $i := 0
    while i < n {
        seed = (seed * 1103515245 + 12345) & 2147483647
        data.push(seed & 255)
        i += 1
    }
    poly := 3988292384
    mask32 := 4294967295
    $total := 0
    $round := 0
    while round < 20 {
        $crc := mask32
        $k := 0
        while k < n {
            b := data[k]
            crc = crc ^ b
            $bit := 0
            while bit < 8 {
                if (crc & 1) != 0 {
                    crc = ((crc >> 1) & 2147483647) ^ poly
                } else {
                    crc = (crc >> 1) & 2147483647
                }
                bit += 1
            }
            k += 1
        }
        total += crc ^ mask32
        round += 1
    }
    println(total)
    << 0
}
